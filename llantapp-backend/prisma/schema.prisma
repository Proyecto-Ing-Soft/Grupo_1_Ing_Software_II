// === Conexión y generador ===
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// === Roles ===
enum Rol {
  ADMIN
  MECANICO
  CLIENTE
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
  LEGAL_ITV
  EXTRAS
}

enum EstadoCita {
  SOLICITADA
  EN_PROGRESO
  TERMINADA
}

enum EstadoNotificacion {
  PENDIENTE
  LEIDA
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombreCompleto String
  correo         String   @unique
  hashClave      String
  rol            Rol      @default(CLIENTE)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  // Si pertenece a una empresa
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Vehículos
  vehiculosPropietario Vehiculo[] @relation("VehiculosPropietario")
  vehiculosCreados     Vehiculo[] @relation("VehiculosCreados")

  // Notificaciones recibidas
  notificaciones Notificacion[]

  // Citas como cliente y como mecánico
  citasComoCliente  CitaMantenimiento[] @relation("CitasCliente")
  citasComoMecanico CitaMantenimiento[] @relation("CitasMecanico")

  // Calificaciones hechas
  calificacionesHechas CalificacionCita[]

  // Servicios para los que el usuario (mecánico) está habilitado
  serviciosHabilitados ServicioMecanico[] @relation("MecanicosHabilitados")

  // Intervenciones externas registradas por este usuario (cliente)
  intervencionesExternas IntervencionExterna[]

  // ✅ NUEVO: acciones de auditoría donde participa este usuario (actor)
  acciones AccionUsuario[]
}

model Empresa {
  id          Int        @id @default(autoincrement())
  razonSocial String
  ruc         String     @unique
  creadoEn    DateTime   @default(now())
  usuarios    Usuario[]
  vehiculos   Vehiculo[]
}

model Vehiculo {
  id     Int     @id @default(autoincrement())
  placa  String  @unique
  marca  String
  modelo String
  anio   Int
  color  String
  vin    String?

  // propietario (obligatorio)
  propietarioUsuarioId Int
  propietario          Usuario @relation("VehiculosPropietario", fields: [propietarioUsuarioId], references: [id])

  // auditoría de creación (obligatorio)
  creadoPorId Int
  creadoPor   Usuario @relation("VehiculosCreados", fields: [creadoPorId], references: [id])

  // Pertenencia (opcional)
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Citas de mantenimiento asociadas a este vehículo
  citas CitaMantenimiento[]

  // Notificaciones ligadas al vehículo (si aplica)
  notificaciones Notificacion[]

  // Intervenciones externas asociadas a este vehículo
  intervencionesExternas IntervencionExterna[]

  @@index([empresaId])
}

// === Catálogo de servicios ===
model Servicio {
  id              Int      @id @default(autoincrement())
  nombre          String   @unique
  descripcion     String   @db.Text
  activo          Boolean  @default(true)
  precioSugerido  Decimal? @db.Decimal(10, 2) // opcional
  duracionMinutos Int? // opcional

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Mecánicos habilitados (muchos-a-muchos explícito)
  mecanicosHabilitados ServicioMecanico[]

  // Citas que referencian este servicio (opcional en citas para compatibilidad)
  citas CitaMantenimiento[]
}

// === Relación Servicio <-> Mecánico con habilitación ===
model ServicioMecanico {
  servicioId    Int
  mecanicoId    Int
  habilitado    Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now())

  servicio Servicio @relation(fields: [servicioId], references: [id])
  mecanico Usuario  @relation("MecanicosHabilitados", fields: [mecanicoId], references: [id])

  @@id([servicioId, mecanicoId])
  @@index([mecanicoId])
}

// Cita de mantenimiento con snapshot de vehículo
model CitaMantenimiento {
  id                 Int               @id @default(autoincrement())
  tipo               TipoMantenimiento
  comentario         String            @db.Text
  estado             EstadoCita        @default(SOLICITADA)
  programadaPara     DateTime?
  fechaMantenimiento DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  clienteId Int
  cliente   Usuario @relation("CitasCliente", fields: [clienteId], references: [id])

  mecanicoId Int?
  mecanico   Usuario? @relation("CitasMecanico", fields: [mecanicoId], references: [id])

  vehiculoId Int?
  vehiculo   Vehiculo? @relation(fields: [vehiculoId], references: [id])

  // referencia al ítem del catálogo (opcional para compatibilidad)
  servicioId Int?
  servicio   Servicio? @relation(fields: [servicioId], references: [id])

  // Snapshot preliminar del vehículo
  placaPreliminar  String
  marcaPreliminar  String
  modeloPreliminar String
  anioPreliminar   Int?
  colorPreliminar  String?
  vinPreliminar    String?

  notificaciones Notificacion[]

  trabajosRealizados String?
  repuestos          Json?

  evidenciaBytes  Bytes?
  evidenciaMime   String?
  evidenciaNombre String?

  calificacion CalificacionCita?

  // Acciones asociadas a esta cita (crear, asignar, terminar, etc.)
  acciones AccionUsuario[]

  @@index([clienteId])
  @@index([mecanicoId, estado])
  @@index([vehiculoId])
  @@index([placaPreliminar])
  @@index([servicioId])
}

model Notificacion {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  vehiculoId Int?
  vehiculo   Vehiculo? @relation(fields: [vehiculoId], references: [id])

  citaId Int?
  cita   CitaMantenimiento? @relation(fields: [citaId], references: [id])

  mensaje  String
  estado   EstadoNotificacion @default(PENDIENTE) // PENDIENTE | LEIDA
  creadoEn DateTime           @default(now())

  @@index([usuarioId, estado])
  @@index([vehiculoId])
  @@index([citaId])
}

model CalificacionCita {
  id         Int      @id @default(autoincrement())
  citaId     Int      @unique
  clienteId  Int
  estrellas  Int      @db.SmallInt // 1..5 (validar en servicio)
  comentario String?
  creadaEn   DateTime @default(now())

  // Relaciones
  cita    CitaMantenimiento @relation(fields: [citaId], references: [id], onDelete: Cascade)
  cliente Usuario           @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

// === Bitácora de acciones de usuario sobre citas ===
model AccionUsuario {
  id Int @id @default(autoincrement())

  // QUIÉN realizó la acción (actor)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // QUÉ acción fue
  tipo String // p.ej.: "CREAR_CITA", "ASIGNAR_MECANICO", "TERMINAR_CITA"

  // SOBRE QUÉ cita se hizo la acción (si aplica)
  citaId Int?
  cita   CitaMantenimiento? @relation(fields: [citaId], references: [id])

  // MECÁNICO involucrado (si aplica, por ejemplo en la asignación o en el cierre)
  mecanicoId Int?

  // TEXTO legible para mostrar en la UI
  descripcion String @db.Text

  // CUÁNDO se registró la acción
  creadoEn DateTime @default(now())

  @@index([usuarioId, creadoEn])
  @@index([tipo, creadoEn])
  @@index([citaId])
}

model IntervencionExterna {
  id Int @id @default(autoincrement())

  vehiculoId Int
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])

  clienteId Int
  cliente   Usuario @relation(fields: [clienteId], references: [id])

  fecha           DateTime
  kilometraje     Int?
  descripcion     String   @db.Text
  tallerNombre    String?
  costoAproximado Decimal? @db.Decimal(10, 2)

  creadoEn DateTime @default(now())

  @@index([vehiculoId])
  @@index([clienteId, fecha])
}

model Consumible {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  unidad        String   // ej: "lt", "und", "kg"
  stockActual   Int      @default(0)
  stockMinimo   Int      @default(0)
  descripcion   String?  @db.Text
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}


