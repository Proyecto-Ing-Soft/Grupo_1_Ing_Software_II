# Conexión a PostgreSQL con tu clave real: .ENV(2812 es la clave de tu server y SOftware2Grupo1 es el nombre de tu db)
DATABASE_URL="postgresql://postgres:postgresql@localhost:5433/Software2Grupo1"
# Configuración de JWT
JWT_ACCESS_SECRET="llantapp-clave-super-secretaxdd"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="llantapp-clave-super-secretaxdd2"
JWT_REFRESH_TTL="7d"
# Configuración de CORS (React frontend en localhost)
CORS_ORIGINS="http://localhost:5173"
# Cookies
COOKIE_SECURE=false   # true en producción con HTTPS



