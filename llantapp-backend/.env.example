# Conexión a PostgreSQL con tu clave real: .ENV(2812 es la clave de tu server y SOftware2Grupo1 es el nombre de tu db)
# 1) Para correr migraciones iniciales como superusuario (postgres)
# IMPORTANTE: CAMBIAR "1234" POR LA CLAVE REAL DEL USUARIO postgres DE CADA UNO
DATABASE_URL="postgresql://postgres:1234@localhost:15432/llantapp?schema=app"
DATABASE_URL_RO="postgresql://postgres:1234@localhost:15435/llantapp?schema=app"

# 2) (OPCIONAL, después de migrar) cambia a la cuenta de app:
# DATABASE_URL="postgresql://llantapp_backend:backend@localhost:5432/llantapp?schema=app"
# DATABASE_URL_RO="postgresql://llantapp_backend:backend@localhost:5435/llantapp?schema=app"

JWT_SECRET=pon-un-secreto-fuerte-aqui

# Configuración de JWT
JWT_ACCESS_SECRET=supersecreto
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=supersecreto_refresh
JWT_REFRESH_TTL="7d"
# Configuración de CORS (React frontend en localhost)
CORS_ORIGINS="http://localhost:5173"
# Cookies
COOKIE_SECURE=false   # true en producción con HTTPS

# === Correo saliente (bot) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=bot.llantapp@gmail.com
MAIL_PASS=pzktruliqxupmrvo
MAIL_FROM=LlantApp Bot <bot.llantapp@gmail.com>
MAIL_TO=soporte.llantapp@gmail.com

# === Patroni / PostgreSQL HA ===
LLANTAPP_DB_NAME=llantapp

LLANTAPP_DB_SUPERUSER=postgres
# CAMBIAR "1234" POR LA CLAVE REAL DEL USUARIO postgres EN SU POSTGRES LOCAL
LLANTAPP_DB_SUPERUSER_PASSWORD=1234

LLANTAPP_DB_REPL_USER=replicator
LLANTAPP_DB_REPL_PASSWORD=replicator

# Directorio base para los datos del cluster HA (cada dev puede cambiar esto si quiere)
LLANTAPP_DATA_DIR_ROOT=C:/llantapp/patroni
# En PATH así: C:\llantapp\patroni

# Ruta a los binarios de PostgreSQL (ajusta según tu instalación real) Poner en PATH
LLANTAPP_PG_BIN_DIR=C:/Program Files/PostgreSQL/17/bin
# En PATH así: C:\Program Files\PostgreSQL\17\bin

# Puerto externo de escritura/lectura expuestos por HAProxy
LLANTAPP_DB_PORT_WRITE=15432
LLANTAPP_DB_PORT_READ=15435

# (Opcional) Ruta a haproxy.exe si no está en el PATH
LLANTAPP_HAPROXY_BIN=C:/Program Files/HAProxy/haproxy.exe
# En PATH así: C:\Program Files\HAProxy\haproxy.exe

# ======== Comandos para creación de base de datos: ======== #
#### Instalar esto en POWERSHELL como ADMINISTRADOR:
# Copiar y pegar tal cual lo de llantapp-backend\instalacion-haproxi.txt como ADMINISTRADOR en POWERSHELL
#
#### DESPUÉS ESTO EN LA TERMINAL DE VSCODE, EN LA RAÍZ DEL REPO (Grupo_1_Ing_Software_II):
# 1) Crear y preparar el entorno (solo la primera vez):
# python -m venv .venv
# .\.venv\Scripts\pip install "patroni[raft,psycopg2-binary]"
# (Instalar PostgreSQL y HAProxy una sola vez en su máquina)
#
# 2) Levantar el cluster HA desde cero (cada vez que quieran recrear la BD):
# Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
# .\.venv\Scripts\Activate.ps1
# Get-Process patroni, haproxy -ErrorAction SilentlyContinue | Stop-Process -Force
# Remove-Item .\127.0.0.1_700*.dump* -ErrorAction SilentlyContinue
# Remove-Item .\127.0.0.1_700*.journal* -ErrorAction SilentlyContinue
# Remove-Item -Recurse -Force C:\llantapp\patroni -ErrorAction SilentlyContinue
# New-Item -ItemType Directory -Path C:\llantapp\patroni\node1\data -Force | Out-Null
# New-Item -ItemType Directory -Path C:\llantapp\patroni\node2\data -Force | Out-Null
# New-Item -ItemType Directory -Path C:\llantapp\patroni\node3\data -Force | Out-Null
# powershell -ExecutionPolicy Bypass -File .\infra\start-ha.ps1
#
# (Opcional) Verificar el estado del cluster:
# .\.venv\Scripts\patronictl.exe -c .\infra\patroni\node1.yml list
#
# 3) Probar conexión y crear la base de datos (usar la clave real de postgres cuando la pida):
# & "C:\Program Files\PostgreSQL\17\bin\psql.exe" -h localhost -p 15432 -U postgres -c "select 1;"
# & "C:\Program Files\PostgreSQL\17\bin\psql.exe" -h localhost -p 15432 -U postgres -c "CREATE DATABASE llantapp;"
#
# 4) Aplicar migraciones:
# cd llantapp-backend
# npx prisma migrate deploy
#
# NOTA: Asegurarse de que "1234" en DATABASE_URL y LLANTAPP_DB_SUPERUSER_PASSWORD se cambie por la clave real de su usuario postgres.

# ======== Comandos para actualización de base de datos: ======== #
# cd llantapp-backend
# npx prisma migrate deploy
# npx prisma generate
# cd ../
# npm run dev