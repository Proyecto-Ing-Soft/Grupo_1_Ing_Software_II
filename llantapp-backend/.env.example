# =========================
# App
# =========================
# development | test | production
NODE_ENV=development
# Puerto local de la app
PORT=3000

# =========================
# Base de datos (Prisma/ORM)
# Formato PostgreSQL:
# postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
# Ejemplo: postgresql://postgres:CHANGE_ME@localhost:5432/mi_base?schema=public
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public

# =========================
# Autenticación / Tokens
# Usa una frase aleatoria larga en producción
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO
JWT_EXPIRES_IN=1d

# =========================
# Cache / Cola (si aplica)
REDIS_URL=redis://USUARIO:CONTRASENA@HOST:6379
# Ejemplo simple local: redis://localhost:6379

# =========================
# Correo saliente (si aplica)
SMTP_HOST=SMTP_HOST
SMTP_PORT=587
SMTP_USER=SMTP_USUARIO
SMTP_PASS=SMTP_CONTRASENA
SMTP_FROM="Nombre App <no-reply@tu-dominio.com>"

# =========================
# URLs del frontend/backend (si aplica)
API_BASE_URL=http://localhost:3000
# Para frameworks tipo Next.js (solo variables públicas)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# =========================
# Observabilidad (si aplica)
LOG_LEVEL=info
# trace | debug | info | warn | error | fatal

# =========================
# Cloud / Terceros (placeholder, no secrets)
#GCP_PROJECT_ID=TU_PROYECTO
#S3_BUCKET=tu-bucket
#STRIPE_PUBLIC_KEY=pk_test_CAMBIAR
#STRIPE_WEBHOOK_SECRET=whsec_CAMBIAR