// KISS: Modelo mínimo para autenticación.
// OCP: Podemos extender con más campos sin romper el flujo actual.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombreCompleto String
  correo         String   @unique
  hashClave      String
  rol            Rol      @default(ASISTENTE)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  vehiculosCreados Vehiculo[] @relation("VehiculosCreados")
}

enum Rol {
  ADMIN
  MECANICO
  ASISTENTE
  CONDUCTOR
}

model Vehiculo {
  id            Int      @id @default(autoincrement())
  placa         String   @unique
  marca         String
  modelo        String
  anio          Int
  color         String
  vin           String?
  creadoPorId   Int
  creadoPor     Usuario  @relation("VehiculosCreados", fields: [creadoPorId], references: [id])
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}
