// === Conexión y generador ===
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// === Roles: añadimos CHOFER y EMPRESA ===
// OCP: ampliamos el enum sin romper flujos existentes.
enum Rol {
  ADMIN
  MECANICO
  ASISTENTE
  CHOFER
  EMPRESA
}

// === Usuarios ===
model Usuario {
  id             Int      @id @default(autoincrement())
  nombreCompleto String
  correo         String   @unique
  hashClave      String
  rol            Rol      @default(ASISTENTE)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  // Si pertenece a una empresa
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Relaciones
  vehiculosCreados    Vehiculo[]     @relation("VehiculosCreados")
  vehiculosComoChofer Vehiculo[]     @relation("ChoferVehiculo")
  notificaciones      Notificacion[]
}

model Empresa {
  id          Int        @id @default(autoincrement())
  razonSocial String
  ruc         String     @unique
  creadoEn    DateTime   @default(now())
  usuarios    Usuario[]
  vehiculos   Vehiculo[]
}

// === Vehículos con datos para reglas de notificación ===
model Vehiculo {
  id     Int     @id @default(autoincrement())
  placa  String  @unique
  marca  String
  modelo String
  anio   Int
  color  String
  vin    String?

  // Auditoría de creación
  creadoPorId Int
  creadoPor   Usuario @relation("VehiculosCreados", fields: [creadoPorId], references: [id])

  // Pertenencia (opcional)
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  // Chofer principal (para notificar)
  choferId Int?
  chofer   Usuario? @relation("ChoferVehiculo", fields: [choferId], references: [id])

  // --- Datos operativos para CU-03 ---
  kms                       Int       @default(0) // odómetro actual
  proximoMantenimientoKm    Int? // umbral por km
  proximoMantenimientoFecha DateTime? // umbral por fecha

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Llantas asociadas (para vencimientos)
  llantas      Llanta[]
  Notificacion Notificacion[]

  @@index([choferId])
  @@index([empresaId])
}

model Llanta {
  id               Int       @id @default(autoincrement())
  vehiculoId       Int
  vehiculo         Vehiculo  @relation(fields: [vehiculoId], references: [id])
  posicion         String? // ej. "DI-IZQ", "TR-DR"
  fechaInstalacion DateTime?
  fechaVencimiento DateTime // usado por la regla de vencimiento
  vidaUtilKm       Int? // si luego deseas calcular por km

  creadoEn DateTime @default(now())

  @@index([vehiculoId])
  @@index([fechaVencimiento])
}

// === Notificaciones In-App (historial y estado) ===
model Notificacion {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  vehiculoId Int?
  vehiculo   Vehiculo? @relation(fields: [vehiculoId], references: [id])

  tipo        TipoNotificacion
  mensaje     String
  prioridad   PrioridadNotificacion @default(MEDIA)
  estado      EstadoNotificacion    @default(PENDIENTE)
  fechaLimite DateTime?
  creadoEn    DateTime              @default(now())

  @@index([usuarioId, estado])
  @@index([vehiculoId])
}

enum TipoNotificacion {
  MANTENIMIENTO_KM
  MANTENIMIENTO_FECHA
  VENCIMIENTO_LLANTA
}

enum PrioridadNotificacion {
  BAJA
  MEDIA
  ALTA
}

enum EstadoNotificacion {
  PENDIENTE
  LEIDA
}
